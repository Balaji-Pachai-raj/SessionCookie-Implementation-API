  user_role_mapping_id BigInt            @id @default(autoincrement())
  nt_id                String            @db.VarChar(30)
  role_id              BigInt
  is_active            Boolean           @default(true)
  created_by           String            @db.VarChar(50)
  updated_by           String            @db.VarChar(50)
  created_at           DateTime          @default(now()) @db.Timestamp(0)
  updated_at           DateTime          @db.Timestamp(0)
  request_remarks      request_remarks[]
  users                users             @relation(fields: [nt_id], references: [nt_id])
  role_master          role_master       @relation(fields: [role_id], references: [role_id])

  @@unique([nt_id, role_id])
  @@schema("users")
}

model user_view_preference {
  user_view_preference_id BigInt    @id @default(autoincrement())
  user_id                 BigInt
  view_name               ViewName
  preferences             String
  created_at              DateTime  @default(now()) @db.Timestamp(0)
  updated_at              DateTime? @db.Timestamp(0)
  created_by              String?   @db.VarChar(255)
  updated_by              String?   @db.VarChar(255)
  users                   users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([user_id, view_name], map: "user_view_unique")
  @@schema("users")
}

