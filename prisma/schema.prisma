generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["casbin", "doctors", "documents", "emails", "hcp_claims", "hospitals", "masters", "notifications", "public", "users"]
}

model casbin_rule {
  id    Int     @id @default(autoincrement())
  ptype String  @db.VarChar(10)
  v0    String? @db.VarChar(50)
  v1    String? @db.VarChar(50)
  v2    String? @db.VarChar(50)
  v3    String? @db.VarChar(50)
  v4    String? @db.VarChar(50)
  v5    String? @db.VarChar(50)

  @@unique([ptype, v0, v1, v2, v3, v4, v5], map: "casbin_policy_ptype_v0_v1_v2_v3_v4_v5_key")
  @@schema("casbin")
}

model doctor_qualifications {
  id                                            BigInt                       @id @default(autoincrement())
  doctor_id                                     BigInt?
  doctor_qualification_id                       BigInt?
  created_by                                    BigInt?
  updated_by                                    BigInt?
  is_active                                     Boolean                      @default(true)
  created_at                                    DateTime                     @default(now())
  updated_at                                    DateTime
  users_doctor_qualifications_created_byTousers users?                       @relation("doctor_qualifications_created_byTousers", fields: [created_by], references: [user_id], onDelete: Restrict)
  doctor_master                                 doctor_master?               @relation(fields: [doctor_id], references: [id])
  doctor_qualification_master                   doctor_qualification_master? @relation(fields: [doctor_qualification_id], references: [id])
  users_doctor_qualifications_updated_byTousers users?                       @relation("doctor_qualifications_updated_byTousers", fields: [updated_by], references: [user_id], onDelete: Restrict)

  @@schema("doctors")
}

model document {
  document_id                      BigInt                @id @default(autoincrement())
  claim_id                         String?               @db.VarChar(50)
  policy_id                        String?               @db.VarChar(50)
  hospital_id                      String?               @db.VarChar(50)
  document_source                  document_source_enum?
  document_source_ref_id           String?               @db.VarChar(50)
  document_type_id                 BigInt?
  store_location                   store_location_enum?
  object_id                        String?               @db.VarChar(50)
  document_name                    String?               @db.VarChar(255)
  mime_type                        String?               @db.VarChar(50)
  file_size                        Float?
  is_split_required                Boolean?
  split_ref_id                     String?               @db.VarChar(50)
  split_start_at                   DateTime?
  split_end_at                     DateTime?
  split_status                     String?               @db.VarChar(50)
  split_count                      Int?
  is_split_done                    Boolean?
  parent_document_id               String?               @db.VarChar(50)
  is_adhar_mask_required           Boolean?
  adhar_mask_ref_id                String?               @db.VarChar(50)
  adhar_mask_start_at              DateTime?
  adhar_mask_end_at                DateTime?
  adhar_mask_status                String?               @db.VarChar(50)
  is_adhar_mask_done               Boolean?
  failed_adhar_mask_retry_count    Int?
  compress_ref_id                  String?               @db.VarChar(50)
  compress_start_at                DateTime?
  compress_end_at                  DateTime?
  compress_status                  String?               @db.VarChar(100)
  is_compress_done                 Boolean?
  compressed_size                  Float?
  current_stage                    document_stage_enum?
  is_archived                      Boolean?
  is_notified                      Boolean               @default(false)
  created_by                       BigInt
  updated_by                       BigInt
  created_at                       DateTime              @default(now())
  updated_at                       DateTime
  external_doc_id                  String                @unique(map: "document_external_doc_id_unique") @db.Uuid
  failed_split_retry_count         Int?
  failed_compress_retry_count      Int?
  deferred_retry_count             Int?
  cloud_folder_deleted_at          DateTime?
  upload_status                    String?               @db.VarChar(100)
  failed_is_notified_retry_count   Int?                  @default(0)
  file_hash                        String?               @db.VarChar(255)
  users_document_created_byTousers users                 @relation("document_created_byTousers", fields: [created_by], references: [user_id])
  users_document_updated_byTousers users                 @relation("document_updated_byTousers", fields: [updated_by], references: [user_id])
  document_type_master             document_type_master? @relation(fields: [document_type_id], references: [document_type_id], map: "documents_document_type_id_fkey")

  @@schema("documents")
}

model webhook_config {
  id          BigInt                @id @default(autoincrement())
  source      document_source_enum?
  webhook_url String?
  is_active   Boolean?              @default(true)
  created_by  BigInt
  updated_by  BigInt
  created_at  DateTime              @default(now())
  updated_at  DateTime

  @@schema("documents")
}

model claim_emails {
  claim_email_id               BigInt                @id @default(autoincrement())
  inbox_subscription_id        String                @db.VarChar(100)
  inbox_email_reference_id     String?               @unique @db.VarChar(200)
  conversation_id              String?               @db.VarChar(100)
  subject                      String?               @db.VarChar(255)
  email_received_date          DateTime?             @db.Timestamp(0)
  from                         Json?
  to_recipients                Json?
  cc_recipients                Json?
  bcc_recipients               Json?
  body                         Json?
  email_priority               String?
  total_attachments            Int?
  in_reply_to                  String?               @db.VarChar(200)
  actioned_at                  DateTime?             @db.Timestamp(0)
  email_type                   EmailType?
  mode_of_processing           ProcessingMode?       @default(AUTOMATED)
  is_automated_process_success Boolean?
  processed_by                 ProcessedBy?
  email_action                 EmailAction?
  interaction_locked           Boolean?              @default(false)
  claim_id                     String?
  policy_number                String?               @db.VarChar(50)
  attachment_saved             Boolean?
  extracted_claim_data         Json?
  claim_created_by             ClaimCreatedBy?
  completed_date               DateTime?             @db.Timestamp(0)
  email_deleted_date           DateTime?             @db.Timestamp(0)
  remarks                      String?
  user_id                      BigInt?
  status                       ClaimEmailStatus?     @default(OPEN)
  created_at                   DateTime              @default(now()) @db.Timestamp(0)
  created_by                   String?               @db.VarChar(20)
  updated_at                   DateTime              @default(now()) @db.Timestamp(0)
  updated_by                   String?               @db.VarChar(20)
  email_sent_date              DateTime?             @db.Timestamp(0)
  email_received_via           EmailReceivedVia?
  thread_id                    String?               @db.VarChar(50)
  attachments_processed        Boolean?              @default(false)
  users                        users?                @relation(fields: [user_id], references: [user_id], onUpdate: NoAction, map: "claim_emails_user_fkey")
  email_assignments            email_assignments[]
  email_attachments            email_attachments[]
  email_lock_history           email_lock_history[]
  email_query_replies          email_query_replies[]
  outbound_emails              outbound_emails[]
  claims                       claims[]
  quick_upload                 quick_upload[]

  @@index([conversation_id])
  @@index([email_received_date], map: "claim_emails_received_date_idx")
  @@index([status])
  @@schema("emails")
}

model email_assignments {
  email_assignment_id BigInt           @id @default(autoincrement())
  claim_email_id      BigInt
  assigned_by         String?          @db.VarChar(20)
  assigned_to         String?          @db.VarChar(20)
  assigned_at         DateTime?        @db.Timestamp(0)
  remarks             String?
  assigned_status     AssignmentStatus @default(OPEN)
  is_active           Boolean          @default(true)
  completed_at        DateTime?        @db.Timestamp(0)
  created_at          DateTime         @default(now()) @db.Timestamp(0)
  updated_at          DateTime         @default(now()) @db.Timestamp(0)
  claim_emails        claim_emails     @relation(fields: [claim_email_id], references: [claim_email_id], onDelete: Cascade, onUpdate: NoAction, map: "email_assignments_claim_email_fkey")

  @@index([claim_email_id], map: "email_assignments_claim_email_idx")
  @@index([assigned_status], map: "email_assignments_status_idx")
  @@schema("emails")
}

model email_attachments {
  email_attachment_id     BigInt        @id @default(autoincrement())
  claim_email_id          BigInt?
  claim_email_document_id String?       @db.VarChar(200)
  document_name           String?
  document_size           Int?
  claim_document_dms_id   String?       @db.VarChar(50)
  created_at              DateTime      @default(now()) @db.Timestamp(0)
  created_by              String?       @db.VarChar(20)
  updated_at              DateTime      @default(now()) @db.Timestamp(0)
  updated_by              String?       @db.VarChar(20)
  attachment_processed    Boolean?      @default(false)
  claim_emails            claim_emails? @relation(fields: [claim_email_id], references: [claim_email_id], onDelete: Cascade, onUpdate: NoAction, map: "email_attachments_claim_email_fkey")

  @@index([claim_email_id], map: "email_attachments_claim_email_idx")
  @@schema("emails")
}

model email_delta_links {
  delta_id        BigInt   @id @default(autoincrement())
  delta_link      String?
  next_delta_link String?
  created_at      DateTime @default(now()) @db.Timestamp(0)
  created_by      String?  @db.VarChar(20)
  updated_at      DateTime @default(now()) @db.Timestamp(0)
  updated_by      String?  @db.VarChar(20)

  @@schema("emails")
}

model email_lock_history {
  email_lock_id  BigInt        @id @default(autoincrement())
  claim_email_id BigInt?
  locked_at      DateTime?     @db.Timestamp(0)
  unlocked_by    String?       @db.VarChar(20)
  unlocked_at    DateTime?     @db.Timestamp(0)
  reason         String?
  lock_type      EmailLockType
  created_at     DateTime      @default(now()) @db.Timestamp(0)
  created_by     String?       @db.VarChar(20)
  updated_at     DateTime      @default(now()) @db.Timestamp(0)
  updated_by     String?       @db.VarChar(20)
  claim_emails   claim_emails? @relation(fields: [claim_email_id], references: [claim_email_id], onDelete: Cascade, onUpdate: NoAction, map: "email_lock_history_claim_email_fkey")

  @@index([claim_email_id], map: "email_lock_history_claim_email_idx")
  @@schema("emails")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model email_query_replies {
  email_query_reply_id                        BigInt       @id @default(autoincrement())
  claim_email_id                              BigInt
  claim_no                                    String?      @db.VarChar(50)
  reply_text                                  String?
  docs_attached_with_claim                    Json?
  created_by                                  BigInt
  updated_by                                  BigInt?
  created_at                                  DateTime     @default(now()) @db.Timestamptz(6)
  updated_at                                  DateTime?    @db.Timestamptz(6)
  claim_emails                                claim_emails @relation(fields: [claim_email_id], references: [claim_email_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_email_query_replies_claim_emails")
  users_email_query_replies_created_byTousers users        @relation("email_query_replies_created_byTousers", fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_email_query_replies_created_by")
  users_email_query_replies_updated_byTousers users?       @relation("email_query_replies_updated_byTousers", fields: [updated_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_email_query_replies_updated_by")

  @@index([claim_email_id], map: "idx_email_query_replies_claim_email_id")
  @@schema("emails")
}

model email_subscription_lifecycle_events {
  lifecycle_event_id BigInt    @id @default(autoincrement())
  subscription_id    String?   @db.VarChar(200)
  lifecycle_event    String?   @db.VarChar(50)
  event_payload      Json?
  created_at         DateTime  @default(now()) @db.Timestamp(0)
  created_by         String?   @db.VarChar(20)
  expires_at         DateTime? @db.Timestamp(0)
  updated_at         DateTime  @default(now()) @db.Timestamp(0)
  updated_by         String?   @db.VarChar(20)

  @@index([subscription_id])
  @@schema("emails")
}

model email_subscriptions {
  email_subscription_id BigInt             @id @default(autoincrement())
  subscription_id       String             @db.VarChar(200)
  status                SubscriptionStatus @default(ACTIVE)
  created_at            DateTime           @default(now()) @db.Timestamp(0)
  created_by            String             @db.VarChar(20)
  expires_at            DateTime?          @db.Timestamp(0)
  updated_at            DateTime           @default(now()) @db.Timestamp(0)
  updated_by            String             @db.VarChar(20)

  @@index([status])
  @@index([subscription_id])
  @@schema("emails")
}

model email_templates {
  email_template_id        BigInt             @id @default(autoincrement())
  mode                     EmailTemplateMode?
  notification_template_id String?            @db.VarChar(20)
  body_template            String
  claim_type               emails_ClaimType?
  inbox_type               InboxType?
  claim_stage              ClaimStage?
  is_active                Boolean?           @default(true)
  created_by               String?            @db.VarChar(20)
  created_at               DateTime           @default(now()) @db.Timestamp(0)
  updated_by               String?            @db.VarChar(20)
  updated_at               DateTime           @default(now()) @db.Timestamp(0)
  outbound_emails          outbound_emails[]

  @@schema("emails")
}

model failed_attachment_log {
  attachment_failure_id    BigInt                     @id @default(autoincrement())
  inbox_email_reference_id String?                    @db.VarChar(200)
  attachment_id            String?                    @db.VarChar(200)
  subscription_id          String?                    @db.VarChar(200)
  error_occurred_at        ErrorOccurredAt?
  error_code               String?                    @db.VarChar(50)
  error_message            String?
  status                   FailedAttachmentLogStatus? @default(PENDING)
  created_at               DateTime                   @default(now()) @db.Timestamp(0)
  created_by               String?                    @db.VarChar(20)
  updated_at               DateTime                   @default(now()) @db.Timestamp(0)
  updated_by               String?                    @db.VarChar(20)

  @@index([status])
  @@schema("emails")
}

model failed_email_log {
  email_failure_id         BigInt                @id @default(autoincrement())
  inbox_email_reference_id String?               @db.VarChar(200)
  subscription_id          String?               @db.VarChar(200)
  error_code               String?               @db.VarChar(20)
  error_message            String?
  status                   FailedEmailLogStatus? @default(PENDING)
  created_at               DateTime              @default(now()) @db.Timestamp(0)
  created_by               String?               @db.VarChar(20)
  updated_at               DateTime              @default(now()) @db.Timestamp(0)
  updated_by               String?               @db.VarChar(20)

  @@index([status])
  @@schema("emails")
}

model outbound_emails {
  outbound_email_id   BigInt               @id @default(autoincrement())
  claim_email_id      BigInt?
  template_id         BigInt?
  action_type         OutboundEmailAction?
  subject             String?              @db.VarChar(250)
  to_recipients       Json?
  cc_recipients       Json?
  bcc_recipients      Json?
  body                Json?
  actual_message      String?
  notification_status NotificationStatus?
  created_at          DateTime             @default(now()) @db.Timestamp(0)
  created_by          String?              @db.VarChar(20)
  updated_at          DateTime             @default(now()) @db.Timestamp(0)
  updated_by          String?              @db.VarChar(20)
  claim_emails        claim_emails?        @relation(fields: [claim_email_id], references: [claim_email_id], onUpdate: NoAction, map: "outbound_emails_claim_email_fkey")
  email_templates     email_templates?     @relation(fields: [template_id], references: [email_template_id], onUpdate: NoAction, map: "outbound_emails_template_fkey")

  @@index([claim_email_id])
  @@index([template_id])
  @@schema("emails")
}

model admission_master {
  admission_id                             BigInt             @id @default(autoincrement())
  name                                     AdmissionStatus    @unique
  is_active                                Boolean            @default(true)
  created_at                               DateTime           @default(now())
  updated_at                               DateTime
  created_by                               BigInt
  updated_by                               BigInt
  users_admission_master_created_byTousers users              @relation("admission_master_created_byTousers", fields: [created_by], references: [user_id])
  users_admission_master_updated_byTousers users              @relation("admission_master_updated_byTousers", fields: [updated_by], references: [user_id])
  claim_admissions                         claim_admissions[]

  @@schema("hcp_claims")
}

model ailment_per_user_master {
  ailment_cause_id                                BigInt    @id @default(autoincrement())
  name                                            String    @db.VarChar(255)
  description                                     String?
  is_active                                       Boolean?  @default(true)
  created_at                                      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at                                      DateTime? @default(now()) @db.Timestamptz(6)
  created_by                                      BigInt
  updated_by                                      BigInt
  is_verified                                     Boolean?  @default(false)
  users_ailment_per_user_master_created_byTousers users     @relation("ailment_per_user_master_created_byTousers", fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ailment_per_user_master_created_by")
  users_ailment_per_user_master_updated_byTousers users     @relation("ailment_per_user_master_updated_byTousers", fields: [updated_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ailment_per_user_master_updated_by")

  @@schema("hcp_claims")
}

model ailments_causes_master {
  ailment_cause_id                               BigInt   @id @default(autoincrement())
  name                                           String   @db.VarChar(255)
  description                                    String?
  is_active                                      Boolean  @default(true)
  created_at                                     DateTime @default(now()) @db.Timestamptz(6)
  updated_at                                     DateTime @default(now()) @db.Timestamptz(6)
  created_by                                     BigInt
  updated_by                                     BigInt
  is_verified                                    Boolean? @default(false)
  users_ailments_causes_master_created_byTousers users    @relation("ailments_causes_master_created_byTousers", fields: [created_by], references: [user_id])
  users_ailments_causes_master_updated_byTousers users    @relation("ailments_causes_master_updated_byTousers", fields: [updated_by], references: [user_id])

  @@schema("hcp_claims")
}

model anesthesia_type_master {
  anesthesia_type_id                             BigInt             @id @default(autoincrement())
  name                                           String             @db.VarChar(100)
  is_active                                      Boolean            @default(true)
  created_at                                     DateTime           @default(now())
  updated_at                                     DateTime
  created_by                                     BigInt
  updated_by                                     BigInt
  users_anesthesia_type_master_created_byTousers users              @relation("anesthesia_type_master_created_byTousers", fields: [created_by], references: [user_id])
  users_anesthesia_type_master_updated_byTousers users              @relation("anesthesia_type_master_updated_byTousers", fields: [updated_by], references: [user_id])
  claim_procedures                               claim_procedures[]

  @@schema("hcp_claims")
}

model bank_verification_requests {
  id                                                 BigInt                       @id @default(autoincrement())
  claim_id                                           BigInt
  payee_bank_details_id                              BigInt
  transaction_id                                     String                       @db.VarChar(255)
  pennydrop_verification_status                      PennydropVerificationStatus?
  account_status                                     AccountStatus?
  name_match_score                                   Int?
  provider                                           Provider
  request                                            String?
  response                                           String?
  request_time                                       DateTime?                    @db.Timestamp(6)
  response_time                                      DateTime?                    @db.Timestamp(6)
  created_by                                         BigInt?
  updated_by                                         BigInt?
  created_at                                         DateTime                     @default(now()) @db.Timestamp(6)
  updated_at                                         DateTime                     @default(now()) @db.Timestamp(6)
  claims                                             claims                       @relation(fields: [claim_id], references: [claim_id], onDelete: Cascade, onUpdate: NoAction)
  users_bank_verification_requests_created_byTousers users?                       @relation("bank_verification_requests_created_byTousers", fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  payee_bank_details                                 payee_bank_details           @relation(fields: [payee_bank_details_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_bank_verification_requests_updated_byTousers users?                       @relation("bank_verification_requests_updated_byTousers", fields: [updated_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([claim_id], map: "idx_bank_verification_requests_claim_id")
  @@index([payee_bank_details_id], map: "idx_bank_verification_requests_payee_bank_details_id")
  @@schema("hcp_claims")
}

model catastrophe_master {
  catastrophe_id                             BigInt    @id @default(autoincrement())
  name                                       String    @db.VarChar
  description                                String?
  start_date                                 DateTime  @db.Timestamptz(6)
  end_date                                   DateTime? @db.Timestamptz(6)
  is_active                                  Boolean   @default(true)
  created_by                                 BigInt
  updated_by                                 BigInt
  created_at                                 DateTime  @default(now())
  updated_at                                 DateTime
  is_verified                                Boolean?  @default(false)
  users_catastrophe_master_created_byTousers users     @relation("catastrophe_master_created_byTousers", fields: [created_by], references: [user_id])
  users_catastrophe_master_updated_byTousers users     @relation("catastrophe_master_updated_byTousers", fields: [updated_by], references: [user_id])

  @@schema("hcp_claims")
}

model checklist_master {
  checklist_master_id                      BigInt                 @id @default(autoincrement())
  checklist_stage_master_id                BigInt
  category                                 String?                @db.VarChar(100)
  question                                 String
  response_type                            ChecklistResponseType
  response_options                         Json?
  display_order                            Int?
  child_ids                                BigInt[]               @default([])
  trigger_on_response                      String?                @db.VarChar(20)
  remarks_required                         Boolean                @default(false)
  is_active                                Boolean                @default(true)
  created_at                               DateTime               @default(now())
  created_by                               BigInt
  updated_at                               DateTime
  updated_by                               BigInt
  users_checklist_master_created_byTousers users                  @relation("checklist_master_created_byTousers", fields: [created_by], references: [user_id])
  checklist_stage_master                   checklist_stage_master @relation(fields: [checklist_stage_master_id], references: [checklist_stage_master_id], map: "checklist_master_stage_fkey")
  users_checklist_master_updated_byTousers users                  @relation("checklist_master_updated_byTousers", fields: [updated_by], references: [user_id])
  checklist_responses                      checklist_responses[]

  @@schema("hcp_claims")
}

model checklist_responses {
  checklist_response_id BigInt           @id @default(autoincrement())
  claim_id              BigInt
  claim_stage_id        BigInt
  checklist_master_id   BigInt
  response              String           @db.VarChar(10)
  remarks               String?
  action_date           DateTime         @default(now())
  action_by             BigInt
  created_at            DateTime         @default(now())
  updated_at            DateTime         @default(now())
  users                 users            @relation(fields: [action_by], references: [user_id])
  checklist_master      checklist_master @relation(fields: [checklist_master_id], references: [checklist_master_id], map: "checklist_responses_checklist_master_fkey")
  claims                claims           @relation(fields: [claim_id], references: [claim_id], map: "checklist_responses_claim_fkey")
  claim_stages          claim_stages     @relation(fields: [claim_stage_id], references: [claim_stage_id], map: "checklist_responses_claim_stage_fkey")

  @@schema("hcp_claims")
}

model checklist_stage_master {
  checklist_stage_master_id                      BigInt                 @id @default(autoincrement())
  previous_processing_stage                      ProcessingStage
  previous_decision                              ChecklistDecisionCode?
  current_processing_stage                       ProcessingStage
  checkist_name                                  String                 @db.VarChar(300)
  coverage_code                                  String[]
  is_active                                      Boolean                @default(true)
  created_at                                     DateTime               @default(now())
  created_by                                     BigInt
  updated_at                                     DateTime
  updated_by                                     BigInt
  checklist_master                               checklist_master[]
